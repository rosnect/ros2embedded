<?xml version="1.0"?>
<package format="3">
  <name>bridge_manager</name>
  <version>0.1.0</version>
  <description>Manager node for launching and tracking ROS2 embedded bridge nodes.</description>
  <maintainer email="maintainer@example.com">ros2embedded maintainers</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>bridge_node</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
