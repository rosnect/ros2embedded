<?xml version="1.0"?>
<package format="3">
  <name>connection_handlers</name>
  <version>0.1.0</version>
  <description>Protocol handler plugins for the ROS2 embedded bridge.</description>
  <maintainer email="maintainer@example.com">ros2embedded maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <build_depend>pkg-config</build_depend>
  <depend>protobuf-dev</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>mosquitto-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <connection_handlers plugin="${prefix}/connection_handler_plugins.xml"/>
  </export>
</package>
